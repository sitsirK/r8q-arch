r8q: media: hi847 device-tree support

The rear telephoto camera of the Samsung Galaxy S20 FE 5G (r8q) is an
SK hynix Hi-847 on qupv3_se10_i2c at 0x21, and drivers/media/i2c/hi847.c
already speaks its register set.  That driver was written for an ACPI
IPU6 laptop, though, where the platform (INT3472) owns the reference
clock, the supplies and XSHUTDOWN, so it has an ACPI match table only and
no power management of its own.

Give it what a device-tree board needs:

  - an of_device_id ("hynix,hi847");
  - the optional reset GPIO and the vddio/avdd/dvdd supplies;
  - runtime-PM callbacks that enable the rails, start MCLK and only then
    release XSHUTDOWN.  Power has to be driven from ->runtime_resume
    rather than from probe: on this SoC the sensor's MCLK branch lives
    inside the camera clock controller's TITAN_TOP power domain, and
    enabling the clock with that domain off fails with
    "cam_cc_mclk3_clk status stuck at 'off'" and -EBUSY.  Letting genpd
    order the domain against the sensor's runtime PM fixes that, and lets
    the domain drop again while the camera is idle.  ->s_stream already
    takes a runtime-PM reference around streaming;
  - the fwnode "orientation" and "rotation" properties, without which
    libcamera reports "Rotation control not available, default to
    0 degrees" and every application shows the preview on its side.

All of the DT resources are optional, so a board that does not describe
them behaves as before.

Signed-off-by: r8q-linux

--- a/drivers/media/i2c/hi847.c
+++ b/drivers/media/i2c/hi847.c
@@ -4,9 +4,12 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <linux/unaligned.h>
 
 #include <media/v4l2-ctrls.h>
@@ -2167,9 +2170,24 @@
 	}
 };
 
+/*
+ * r8q: on a device-tree platform nothing powers the sensor for us -- there is
+ * no ACPI INT3472 to sequence the rails, the reference clock and XSHUTDOWN.
+ * Samsung's downstream node lists an I/O rail from the PMIC plus one discrete
+ * LDO (gpio-switched) that carries analog and core; both names are pointed at
+ * the same regulator when a board wires them together.
+ */
+static const char * const hi847_supply_names[] = {
+	"vddio",	/* Digital I/O, 1.8 V */
+	"avdd",		/* Analog, 2.8 V */
+	"dvdd",		/* Digital core, 1.1 V */
+};
+
 struct hi847 {
 	struct device *dev;
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(hi847_supply_names)];
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -2480,12 +2498,13 @@
 
 static int hi847_init_controls(struct hi847 *hi847)
 {
+	struct v4l2_fwnode_device_properties props;
 	struct v4l2_ctrl_handler *ctrl_hdlr;
 	s64 exposure_max, h_blank;
 	int ret;
 
 	ctrl_hdlr = &hi847->ctrl_handler;
-	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 10);
 	if (ret)
 		return ret;
 
@@ -2541,6 +2560,23 @@
 	hi847->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &hi847_ctrl_ops,
 					 V4L2_CID_VFLIP, 0, 1, 1, 0);
 
+	/*
+	 * Publish how the module is mounted, from the fwnode's "orientation"
+	 * and "rotation" properties. Without these libcamera logs "Rotation
+	 * control not available, default to 0 degrees" and every application
+	 * shows the preview on its side -- which is what happens on a phone,
+	 * where the sensor's long axis runs across the display.
+	 * Both controls are read-only, so ->s_ctrl is never called for them.
+	 */
+	ret = v4l2_fwnode_device_parse(hi847->dev, &props);
+	if (ret)
+		return ret;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &hi847_ctrl_ops,
+					      &props);
+	if (ret)
+		return ret;
+
 	if (ctrl_hdlr->error)
 		return ctrl_hdlr->error;
 
@@ -2840,6 +2876,62 @@
 	return ret;
 }
 
+/*
+ * Power sequence (Hi-847 datasheet / Samsung r8q downstream cam_sensor
+ * power-up table): rails first, then MCLK, then release XSHUTDOWN. The chip
+ * needs a few MCLK cycles with reset high before it will ACK on I2C.
+ *
+ * These are the runtime-PM callbacks, which is what makes the device tree case
+ * work at all on r8q: the MCLK branch lives inside the camera clock
+ * controller's TITAN_TOP power domain, and enabling it with that domain off
+ * gets "cam_cc_mclk3_clk status stuck at 'off'" and -EBUSY. Driving power from
+ * runtime PM lets genpd bring the domain up first, on the way in, and drop it
+ * again when the sensor is idle. ->s_stream already takes a runtime-PM
+ * reference around streaming, so nothing else has to change.
+ */
+static int hi847_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(hi847->supplies),
+				    hi847->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(hi847->clk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(hi847->supplies),
+				       hi847->supplies);
+		return ret;
+	}
+
+	/* Let MCLK settle before XSHUTDOWN is released. */
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(hi847->reset_gpio, 0);
+	/* Internal reset + PLL lock before the first I2C transaction. */
+	usleep_range(10000, 11000);
+
+	return 0;
+}
+
+static int hi847_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hi847 *hi847 = to_hi847(sd);
+
+	gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+	clk_disable_unprepare(hi847->clk);
+	regulator_bulk_disable(ARRAY_SIZE(hi847->supplies), hi847->supplies);
+
+	return 0;
+}
+
+static const struct dev_pm_ops hi847_pm_ops = {
+	SET_RUNTIME_PM_OPS(hi847_power_off, hi847_power_on, NULL)
+};
+
 static void hi847_remove(struct i2c_client *client)
 {
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
@@ -2849,6 +2941,9 @@
 	media_entity_cleanup(&sd->entity);
 	v4l2_ctrl_handler_free(sd->ctrl_handler);
 	pm_runtime_disable(hi847->dev);
+	if (!pm_runtime_status_suspended(hi847->dev))
+		hi847_power_off(hi847->dev);
+	pm_runtime_set_suspended(hi847->dev);
 	mutex_destroy(&hi847->mutex);
 }
 
@@ -2856,6 +2951,7 @@
 {
 	struct hi847 *hi847;
 	unsigned long freq;
+	unsigned int i;
 	int ret;
 
 	hi847 = devm_kzalloc(&client->dev, sizeof(*hi847), GFP_KERNEL);
@@ -2869,6 +2965,25 @@
 		return dev_err_probe(hi847->dev, PTR_ERR(hi847->clk),
 				     "failed to get clock\n");
 
+	/*
+	 * Optional so the ACPI path, where the platform owns power, keeps
+	 * working unchanged.
+	 */
+	hi847->reset_gpio = devm_gpiod_get_optional(hi847->dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(hi847->reset_gpio))
+		return dev_err_probe(hi847->dev, PTR_ERR(hi847->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(hi847_supply_names); i++)
+		hi847->supplies[i].supply = hi847_supply_names[i];
+
+	ret = devm_regulator_bulk_get(hi847->dev, ARRAY_SIZE(hi847->supplies),
+				      hi847->supplies);
+	if (ret)
+		return dev_err_probe(hi847->dev, ret,
+				     "failed to get supplies\n");
+
 	freq = clk_get_rate(hi847->clk);
 	if (freq != HI847_MCLK)
 		return dev_err_probe(hi847->dev, -EINVAL,
@@ -2883,10 +2998,20 @@
 	}
 
 	v4l2_i2c_subdev_init(&hi847->sd, client, &hi847_subdev_ops);
+
+	/*
+	 * Runtime PM is not enabled yet, so power up directly for the chip ID
+	 * read. dev_pm_domain_attach() has already brought TITAN_TOP up for us
+	 * -- the device is not runtime-suspended at this point.
+	 */
+	ret = hi847_power_on(hi847->dev);
+	if (ret)
+		return dev_err_probe(hi847->dev, ret, "failed to power on\n");
+
 	ret = hi847_identify_module(hi847);
 	if (ret) {
 		dev_err(hi847->dev, "failed to find sensor: %d", ret);
-		return ret;
+		goto probe_error_power_off;
 	}
 
 	mutex_init(&hi847->mutex);
@@ -2917,6 +3042,8 @@
 
 	pm_runtime_set_active(hi847->dev);
 	pm_runtime_enable(hi847->dev);
+	pm_runtime_set_autosuspend_delay(hi847->dev, 1000);
+	pm_runtime_use_autosuspend(hi847->dev);
 	pm_runtime_idle(hi847->dev);
 
 	return 0;
@@ -2928,6 +3055,9 @@
 	v4l2_ctrl_handler_free(hi847->sd.ctrl_handler);
 	mutex_destroy(&hi847->mutex);
 
+probe_error_power_off:
+	hi847_power_off(hi847->dev);
+
 	return ret;
 }
 
@@ -2940,10 +3070,18 @@
 MODULE_DEVICE_TABLE(acpi, hi847_acpi_ids);
 #endif
 
+static const struct of_device_id hi847_of_match[] = {
+	{ .compatible = "hynix,hi847" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi847_of_match);
+
 static struct i2c_driver hi847_i2c_driver = {
 	.driver = {
 		.name = "hi847",
 		.acpi_match_table = ACPI_PTR(hi847_acpi_ids),
+		.of_match_table = hi847_of_match,
+		.pm = pm_ptr(&hi847_pm_ops),
 	},
 	.probe = hi847_probe,
 	.remove = hi847_remove,
