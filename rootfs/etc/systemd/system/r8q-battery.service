[Unit]
Description=r8q battery: MAX77705 fuel gauge + charger (SE0) module load
# The geni i2c bus (SE0) carrying the MAX77705 (fuel gauge @0x36, PMIC @0x66,
# charger @0x69) is brought up by r8q-touch.service; the i2c devices are then
# auto-created from the DT. Load the drivers afterwards: fuel gauge (read-only
# telemetry), then the MFD (provides the IRQ domain), then the charger. Cold-load
# once, modules live outside /lib/modules (udev coldplug stays disabled).
After=r8q-touch.service
Requires=r8q-touch.service
ConditionPathExists=!/sys/class/power_supply/max77705-charger

[Service]
Type=oneshot
ExecStart=/usr/bin/insmod /root/ts/max17042_battery.ko
ExecStart=/usr/bin/insmod /root/ts/max77705.ko
ExecStart=/usr/bin/insmod /root/ts/max77705_charger.ko
# USB Type-C / MUIC block (patches/0009), after the charger: it closes the USB
# data switch (no replug after a reboot) and sets the charger's input current
# limit from the detected port type on every attach (DCP 1.5-3 A, CDP 1.5 A).
# sdp_ua: at the 500 mA spec value for a PC port, a running Plasma session uses
# more than the charger may draw and the pack discharges while plugged in;
# 700 mA (rounds to 725) keeps it net positive. '-' so a missing module never fails the unit.
ExecStart=-/usr/bin/insmod /root/ts/max77705_usbc.ko sdp_ua=700000
# Battery charge current 1 A. The input current limit is max77705_usbc's job.
ExecStartPost=/bin/sh -c 'C=/sys/class/power_supply/max77705-charger; for i in $(seq 20); do [ -e $C/constant_charge_current ] && break; sleep 1; done; echo 1000000 > $C/constant_charge_current'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
