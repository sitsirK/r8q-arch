[Unit]
Description=r8q: keep every CPU out of idle (experimental, not a fix for the CPU wedge)
Documentation=file:/usr/local/sbin/r8q-noidle.sh

# Deliberately NOT enabled at boot: this stops the CPUs from ever sleeping, which costs
# power and heat, and it is unproven as a mitigation (see the script's header). To try it:
#
#   systemctl start r8q-noidle ; <heavy work> ; systemctl stop r8q-noidle

[Service]
Type=simple
ExecStart=/usr/local/sbin/r8q-noidle.sh
KillMode=control-group
Restart=no

[Install]
WantedBy=multi-user.target
